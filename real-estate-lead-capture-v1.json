    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst errors = [];\n\n// required fields\nif (!b.full_name || b.full_name.trim().length < 2) errors.push(\"full_name required\");\nif (!b.phone) errors.push(\"phone required\");\nif (![\"buy\", \"rent\", \"sell\"].includes(b.intent)) errors.push(\"intent must be buy/rent/sell\");\n\n// phone check (Pakistan style)\nconst digits = (b.phone || \"\").replace(/\\D/g, \"\");\nconst phoneOk = /^(92|0)?3\\d{9}$/.test(digits);\nif (b.phone && !phoneOk) errors.push(\"phone format invalid\");\n\n// email (optional but agar diya to sahi ho)\nif (b.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(b.email)) errors.push(\"email invalid\");\n\n// budget\nif (b.budget_min && b.budget_max && Number(b.budget_min) > Number(b.budget_max)) {\n  errors.push(\"budget_min cannot exceed budget_max\");\n}\n\nreturn { json: { valid: errors.length === 0, errors, lead: b } };"
      },
