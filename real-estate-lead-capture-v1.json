    {
      "parameters": {
        "jsCode": "const lead = $('Normalize').first().json.lead;\nconst existing = $('Get row(s)').first().json;\n\nconst isDuplicate = !!existing.id;\nconst count = isDuplicate ? (Number(existing.contact_count) || 0) + 1 : 1;\n\nconst waLink = \"https://wa.me/\" + lead.phone.replace(\"+\", \"\");\n\nconst subject = isDuplicate\n  ? `Returning Lead: ${lead.full_name} (${count}x contact)`\n  : `New Lead: ${lead.full_name} - ${lead.intent.toUpperCase()}`;\n\nconst lines = [\n  isDuplicate\n    ? `Ye lead pehle bhi contact kar chuka hai (${count} dafa).`\n    : \"Naya lead aaya hai.\",\n  \"\",\n  `Naam: ${lead.full_name}`,\n  `Phone: ${lead.phone}`,\n  `Email: ${lead.email || \"-\"}`,\n  `Intent: ${lead.intent}`,\n  `Area: ${lead.preferred_area || \"-\"}`,\n  `Property: ${lead.property_type || \"-\"}`,\n  `Budget: ${lead.budget_min ?? \"-\"} se ${lead.budget_max ?? \"-\"}`,\n  `Source: ${lead.source}`,\n  `Message: ${lead.message || \"-\"}`,\n  \"\",\n  `WhatsApp: ${waLink}`\n];\n\nreturn [{\n  json: {\n    isDuplicate,\n    contact_count: count,\n    subject,\n    text: lines.join(\"\\n\")\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -256
      ],
      "id": "e00e3e93-2136-40b9-8ee4-9133030e958b",
      "name": "Build Alert"
    },
    {
      "parameters": {
        "jsCode": "function normalizePhone(raw) {\n  let digits = String(raw || \"\").replace(/\\D/g, \"\");\n  if (digits.length === 11 && digits.startsWith(\"03\")) {\n    digits = \"92\" + digits.slice(1);\n  } else if (digits.length === 10 && digits.startsWith(\"3\")) {\n    digits = \"92\" + digits;\n  }\n  return \"+\" + digits;\n}\n\nfunction cleanText(v) {\n  return String(v ?? \"\").trim();\n}\n\nfunction toNumber(v) {\n  if (v === null || v === undefined || v === \"\") return null;\n  return Number(v);\n}\n\nfunction titleName(name) {\n  return cleanText(name)\n    .split(/\\s+/)\n    .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())\n    .join(\" \");\n}\n\nreturn $input.all().map(item => {\n  const b = item.json.lead || {};\n\n  return {\n    json: {\n      lead: {\n        full_name: titleName(b.full_name),\n        phone: normalizePhone(b.phone),\n        email: cleanText(b.email).toLowerCase(),\n        intent: cleanText(b.intent).toLowerCase(),\n        budget_min: toNumber(b.budget_min),\n        budget_max: toNumber(b.budget_max),\n        preferred_area: cleanText(b.preferred_area),\n        property_type: cleanText(b.property_type).toLowerCase(),\n        source: cleanText(b.source) || \"unknown\",\n        message: cleanText(b.message),\n        status: \"new\",\n        contact_count: 1\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -256
      ],
      "id": "01919eb3-43f9-4b81-ad21-fc7ce363d2fb",
